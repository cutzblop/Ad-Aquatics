# ==============================================================================
# AD AQUATICS — ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to .env and insert your real Supabase project credentials.
# NOTE: Only public client keys (anon key) must be used in frontend client code.
# NEVER expose your Supabase service_role key here.
# ==============================================================================

# Your Supabase Project URL (e.g. https://your-project-id.supabase.co)
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Your Supabase Anonymous Public API Key (found in Supabase Settings -> API)
VITE_SUPABASE_ANON_KEY=your-anon-public-key-here

